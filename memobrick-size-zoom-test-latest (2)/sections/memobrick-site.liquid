<header class="nav">
  <div class="rainbow" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
  <div class="wrap nav-in">
    <a class="logo" href="/"><img referrerpolicy="no-referrer" class="logo-img" src="https://cdn.shopify.com/s/files/1/0375/0107/5595/files/Camara_Memobrick_1_copy_4_1c73c4e8-ec38-42a5-9d06-8513ecc122fb.png" alt="MemoBrick" onerror="this.style.display='none'"></a>
    <button class="burger" id="burger" aria-label="Menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <nav class="nav-links" id="navLinks">
      <a class="navlink" href="/pages/editor">Create</a>
      <button data-go="freeproof" class="navlink">Let us design it</button>
      <a href="/collections/catalogue-picture">Ready-made designs</a>
      <button data-go="corporate" class="navlink">Corporate &amp; bulk</button>
      <a href="#reviews">Reviews</a>
      <a href="#how">How it works</a>
      {% for blog in blogs %}{% if forloop.first %}<a href="{{ blog.url }}">Blog</a>{% endif %}{% endfor %}
      <a class="btn btn-red" href="/pages/editor">Create My MemoBrick</a>
    </nav>
    <div class="cart-wrap">
      <a class="cart-icon" href="{{ routes.cart_url }}" id="cartIconBtn" aria-label="Cart, {{ cart.item_count }} item{% if cart.item_count != 1 %}s{% endif %}" aria-expanded="false" aria-haspopup="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <span class="cart-count" id="cartCount"{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
      <div class="cart-drawer" id="cartDrawer" hidden>
        <div class="cart-drawer-head">
          <b>Your cart</b>
          <button class="cart-drawer-close" id="cartDrawerClose" aria-label="Close cart" type="button">&times;</button>
        </div>
        <div class="cart-ship-bar" id="cartShipBar" hidden>
          <p class="cart-ship-msg" id="cartShipMsg"></p>
          <div class="cart-ship-track"><div class="cart-ship-fill" id="cartShipFill"></div></div>
        </div>
        <div class="cart-drawer-items" id="cartDrawerItems"></div>
        <div class="cart-drawer-foot" id="cartDrawerFoot" hidden>
          <div class="cart-drawer-total">
            <span>Subtotal</span>
            <b id="cartDrawerTotal">$0.00</b>
          </div>
          <a class="btn btn-red" id="cartDrawerCheckout" href="/checkout">Checkout</a>
          <a href="{{ routes.cart_url }}" class="cart-drawer-viewall">View full cart</a>
        </div>
      </div>
    </div>
  </div>
</header>

<main id="top">

  <section class="view" id="view-home"{% if template.suffix == 'editor' %} hidden{% endif %}>
    <div class="wrap hero">
      <p class="eyebrow">{{ section.settings.hero_eyebrow }}</p>
      <h1>{{ section.settings.hero_heading }}</h1>
      <div class="rail" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
      <figure class="hero-img">
        <video id="heroVid" referrerpolicy="no-referrer" poster="{{ 'mb-hero-poster.jpg' | asset_url }}" data-poster-mobile="{{ 'mb-hero-mobile-poster.jpg' | asset_url }}" autoplay muted loop playsinline preload="metadata" aria-label="A customer's hands placing a brick while building their MemoBrick photo mosaic"></video>
        <button class="vidplay" id="heroPlay" aria-label="Play the video" hidden>▶</button>
      </figure>
      <p class="lede">{{ section.settings.hero_text_1 }}</p>
      <p class="lede">{{ section.settings.hero_text_2 }}</p>
      <div class="hero-cta">
        <a class="btn btn-red big" href="/pages/editor">{{ section.settings.hero_button_1 }}</a>
        <button class="btn btn-ghost big" data-go="freeproof">{{ section.settings.hero_button_2 }}</button>
      </div>
      <p class="hero-tertiary">Ordering 10 or more?
         <button class="linky2" data-go="corporate">Corporate &amp; bulk →</button></p>
      <div class="hero-trustbar">
        <span class="htb-stars">★★★★★ <b>4.8</b> · 747 Reviews</span>
        <span>Made &amp; Shipped from Miami</span>
        <span>40+ Colors</span>
        <span>Preview Before Ordering</span>
      </div>
    </div>
  <div class="wrap promo-strip">
    <p><b>Order early &amp; save 20%</b> — create your personalized gift before the holiday rush. Code <b>EARLYBIRD20</b> at checkout.</p>
  </div>

  <section id="transformations" data-accent="yellow">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Real builds, real people</p>
        <h2>See what a photo becomes.</h2>
        <p>Every photo below was taken by the customer who wrote the review — 747 of them, averaging 4.8 stars.</p>
      </div>
      <div class="rev-grid" id="transformTrack" data-count="3"></div>
      <p style="text-align:center;margin-top:28px">
        <a class="btn btn-red big" href="/pages/editor">See your photo in bricks</a>
      </p>
      <p style="text-align:center;margin-top:12px">
        <a class="mini" href="/pages/happy-customers">See all 747 reviews →</a>
      </p>
    </div>
  </section>

  <section id="how" data-accent="blue">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">How it works</p>
        <h2>Upload it. Create it. Build it.</h2>
        <p>Prefer not to design it yourself? Our designers will create it for you — send a photo <button type="button" class="linky" data-go="freeproof">and get a free proof →</button></p>
      </div>
      <div class="steps">
        <article class="step">
          <span class="k">STEP 01</span>
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none"><path d="M32 44V16m0 0l-11 11m11-11l11 11" stroke="#15171B" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M12 44v6a4 4 0 0 0 4 4h32a4 4 0 0 0 4-4v-6" stroke="#0A8FC9" stroke-width="2.5" stroke-linecap="round"></path></svg>
          <h3>Upload</h3>
          <p>Choose a photo you love.</p>
        </article>
        <article class="step">
          <span class="k">STEP 02</span>
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none"><rect x="6" y="12" width="52" height="40" rx="5" fill="#ECEDEF" stroke="#15171B" stroke-width="2.5"></rect><circle cx="23" cy="27" r="6" fill="#F5C518"></circle><path d="M10 46l14-14 10 9 9-8 13 13" stroke="#15171B" stroke-width="2.5" stroke-linejoin="round"></path></svg>
          <h3>Create</h3>
          <p>Turn it into a MemoBrick and make it yours.</p>
        </article>
        <article class="step">
          <span class="k">STEP 03</span>
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none"><rect x="10" y="8" width="44" height="48" rx="4" fill="#fff" stroke="#15171B" stroke-width="2.5"></rect><path d="M18 20h20M18 28h28M18 36h24" stroke="#8C9199" stroke-width="2.5" stroke-linecap="round"></path><circle cx="46" cy="46" r="9" fill="#1E8E4A"></circle><path d="M42 46l3 3 5-6" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          <h3>Order</h3>
          <p>We prepare everything you need.</p>
        </article>
        <article class="step">
          <span class="k">STEP 04</span>
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none"><rect x="8" y="18" width="20" height="14" rx="3" fill="#C41E1E"></rect><rect x="32" y="18" width="24" height="14" rx="3" fill="#0A8FC9"></rect><rect x="8" y="36" width="26" height="14" rx="3" fill="#F5C518"></rect><rect x="38" y="36" width="18" height="14" rx="3" fill="#15171B"></rect><path d="M12 14v-4M20 14v-4M40 14v-4M50 14v-4" stroke="#15171B" stroke-width="2.5" stroke-linecap="round"></path></svg>
          <h3>Build</h3>
          <p>Follow your personalized instructions and bring it to life.</p>
        </article>
      </div>
      <p style="text-align:center;margin-top:36px">
        <a class="btn btn-red big" href="/pages/editor">Create My MemoBrick</a>
      </p>
    </div>
  </section>

