        {%- if blog_link != blank -%}<a href="{{ blog_link.url }}">Blog</a>{%- endif -%}
        <a href="/pages/custom-brick-mosaics-for-brands" target="_blank" rel="noopener">Business services</a>
        <a href="/collections/catalogue-picture">Ready-made designs</a>
        <a href="{{ routes.account_url }}">Track your order</a>
        <a href="#sizes">Sizes</a>
        <a href="#giftinspo">Gift kit</a>
        <a href="#faq">FAQs</a>
        <button class="footlink" data-go="corporate">Corporate &amp; bulk</button>
        <a href="/pages/contact-us" target="_blank" rel="noopener">Contact</a>
        
      </nav>
    </div>
  </div>
</footer>

<div class="instructions" id="instructions" hidden="" data-noedit="">
  <div class="ins-bar">
    <strong>Build instructions</strong>
    <span>Internal document — ships with the kit</span>
    <button class="btn btn-red" id="insPrint">Download PDF</button>
    <button class="mini" id="insClose">Close</button>
  </div>
  <div class="ins-sheets" id="insSheets"></div>
</div>





<div class="cms" id="cms" hidden data-editor-ui>
  <div class="cms-bar">
    <strong>Content editor</strong>
    <span id="cmsCount">0 edits</span>
    <span class="cms-hint">Click any text on the page to change it</span>
    <button class="btn btn-red" id="cmsSave">Download updated site</button>
    <button class="mini" id="cmsUndo">Undo all</button>
    <button class="mini" id="cmsExit">Exit</button>
  </div>
</div>

<div class="cropper" id="cropper" hidden>
  <div class="cr-bar">
    <strong>Choose the area to build</strong>
    <span class="cr-hint">Drag the frame over the face · drag a corner to resize</span>
    <button class="mini" id="crFill">Whole photo</button>
    <button class="mini" id="crFace">Centre</button>
    <button class="btn btn-red" id="crApply">Use this area</button>
    <button class="mini" id="crCancel">Cancel</button>
  </div>
  <div class="cr-stage" id="crStage">
    <img referrerpolicy="no-referrer" id="crImg" alt="Your photo, with a crop frame over it" onerror="var p=this.closest('figure,.giftart,.rev');if(p)p.className+=' img-failed';this.style.display='none'">
    <div class="cr-shade" id="crShade"></div>
    <div class="cr-frame" id="crFrame">
      <span class="h nw"></span><span class="h ne"></span><span class="h sw"></span><span class="h se"></span>
      <i></i><i></i>
    </div>
  </div>
</div>

<div class="buybar" id="buyBar" hidden>
  <div class="bb-in">
    <span class="bb-size" id="bbSize">20 × 20&quot;</span>
    <span class="bb-price" id="bbPrice">$99.88</span>
    <a class="btn btn-red" id="bbCta" href="#" target="_blank" rel="noopener">Order My MemoBrick</a>
  </div>
</div>
<div class="tipsmodal" id="photoTipsModal" hidden role="dialog" aria-modal="true" aria-labelledby="photoTipsTitle">
  <div class="tipsmodal-card">
    <h3 id="photoTipsTitle">Photo tips</h3>
    <p class="acc-help">For best results:</p>
    <ul class="tipscheck">
      <li>Use a clear photo</li>
      <li>Keep faces large in the frame</li>
      <li>Use good lighting</li>
      <li>Avoid very busy backgrounds</li>
      <li>Crop close to the important subject</li>
    </ul>
    <button class="btn full" id="photoTipsGotIt">Got it</button>
  </div>
</div>
<div class="wallview" id="wallView" hidden role="dialog" aria-modal="true" aria-labelledby="wallTitle">
  <div class="wv-bar">
    <strong id="wallTitle">See It in Your Space</strong>
    <span class="wv-sub">Your MemoBrick, at its real size</span>
    <button class="mini" id="wallClose">← Back to editor</button>
    <div class="wv-cta-wrap">
      <button class="btn btn-red" id="wallCart">Looks Good — Order My MemoBrick</button>
      <span class="wv-cta-note">Your design will be saved exactly as shown.</span>
    </div>
  </div>
  <div class="roomsrcs" aria-hidden="true" hidden>
  <img class="roomsrc r-living" id="roomImg-living" alt="" src="{{ 'mb-a25f3642f7.jpg' | asset_url }}" onerror="var p=this.closest('figure,.giftart,.rev');if(p)p.className+=' img-failed';this.style.display='none'">
  <img class="roomsrc r-bedroom" id="roomImg-bedroom" alt="" src="{{ 'mb-b38be1a6cf.jpg' | asset_url }}" onerror="var p=this.closest('figure,.giftart,.rev');if(p)p.className+=' img-failed';this.style.display='none'">
  <img class="roomsrc r-office" id="roomImg-office" alt="" src="{{ 'mb-64f3126123.jpg' | asset_url }}" onerror="var p=this.closest('figure,.giftart,.rev');if(p)p.className+=' img-failed';this.style.display='none'">
  </div>
  <div class="wv-body">
    <div class="wv-stage">
      <canvas id="wallCanvas" width="1400" height="900" aria-label="Your MemoBrick shown on a wall"></canvas>
      <p class="wv-drag" id="wallDragHint">Drag the artwork to reposition it</p>
    </div>

    <aside class="wv-panel">
      <p class="wv-k">Mockup</p>

      <label class="wv-lab" for="wallRoom">Room</label>
      <select id="wallRoom">
        <option value="living">Modern living room</option>
        <option value="bedroom">Bedroom</option>
        <option value="office">Home office</option>
        <option value="nursery">Nursery / kids room</option>
        <option value="gallery">Gallery wall</option>
        <option value="statement">Large statement wall</option>
        <option value="plain">Minimalist wall</option>
      </select>
      <label class="mini full ownroom" for="wallRoomFile" tabindex="0">Upload my room</label>
      <input type="file" id="wallRoomFile" class="file-input" accept="image/*">

      <label class="wv-lab" for="wallSizeSel">Size</label>
      <select id="wallSizeSel"></select>

      <label class="wv-lab" for="wallFrame">Frame</label>
      <select id="wallFrame">
        <option value="none">No frame</option>
        <option value="black">Black frame</option>
        <option value="oak">Oak frame</option>
        <option value="white">White frame</option>
      </select>
      <p class="wv-note">Frames are sold separately — this is a preview only.</p>

      <div class="wv-spec">
        <span class="k">Your MemoBrick</span>
        <b id="wallSize">20 × 20&quot;</b>
        <span id="wallDims">Approx. 20 × 20 inches (51 × 51 cm)</span>
        <span id="wallSpec">4,096 bricks · 4 baseplates</span>
      </div>

      <p class="wv-k">Compare sizes</p>
      <div id="wallSizes"></div>
      <span class="wv-hint">Same room, same photo — only the product size changes. Your design is untouched.</span>

      <div class="wv-tune">
        <label for="wallHeight">Wall height — sets the true size</label>
        <input type="range" id="wallHeight" min="48" max="144" value="108" step="2">
        <span id="wallHeightVal">9 ft wall</span>
      </div>
      <div class="btnrow">
        <button class="mini" id="wallSmaller" aria-label="Show smaller">−</button>
        <button class="mini" id="wallBigger" aria-label="Show larger">+</button>
        <button class="mini" id="wallRotL" aria-label="Rotate left">↺</button>
        <button class="mini" id="wallRotR" aria-label="Rotate right">↻</button>
        <button class="mini" id="wallReset">Reset</button>
        <button class="mini" id="wallDownload">Download</button>
      </div>
    </aside>
  </div>
</div>
<script id="heroSrc" type="text/plain">{{ "mb-hero-build.mp4" | asset_url }}</script>
<script id="heroSrcMobile" type="text/plain">{{ "mb-hero-mobile.mp4" | asset_url }}</script>
<div class="toast" id="toast"></div>




