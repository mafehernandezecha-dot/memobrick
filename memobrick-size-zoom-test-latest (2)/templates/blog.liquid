{%- comment -%}
  Was a bare plain-text list of article links — no images, no excerpts,
  no dates, no site header/footer. Now matches the site's other card
  grids, and actually gives someone a reason to click into a post
  instead of a wall of link text.
{%- endcomment -%}
{%- render 'site-header' -%}
<div class="wrap" style="padding:48px 20px 90px;max-width:1100px">
  <p style="font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3)">
    <a href="/" style="color:inherit;text-decoration:none">MemoBrick</a> <span aria-hidden="true">›</span> Blog
  </p>
  <h1 style="font-family:var(--display);font-size:32px;letter-spacing:-.03em;margin:10px 0 28px">{{ blog.title | escape }}</h1>

  {%- paginate blog.articles by 12 -%}
    {%- if blog.articles.size > 0 -%}
      <div class="shopcard-grid">
        {%- for article in blog.articles -%}
          <a class="shopcard" href="{{ article.url }}">
            {%- if article.image -%}
              <img referrerpolicy="no-referrer" src="{{ article.image | image_url: width: 400 }}"
                alt="{{ article.image.alt | default: article.title | escape }}" loading="lazy" onerror="this.style.display='none'">
            {%- endif -%}
            <span class="shopcard-title" style="padding-top:16px">{{ article.title | escape }}</span>
            <span class="shopcard-price">{{ article.excerpt_or_content | strip_html | truncate: 100 }}</span>
          </a>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <div style="text-align:center;margin-top:32px;display:flex;gap:14px;justify-content:center">
          {%- if paginate.previous -%}<a class="mini" href="{{ paginate.previous.url }}">← Newer</a>{%- endif -%}
          {%- if paginate.next -%}<a class="mini" href="{{ paginate.next.url }}">Older →</a>{%- endif -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <p style="color:var(--ink-2)">No posts yet — check back soon.</p>
    {%- endif -%}
  {%- endpaginate -%}
</div>
{%- render 'site-footer' -%}
