{%- comment -%}
  Generic fallback for any Shopify Page that hasn't been given one of the
  specific templates (page.how-it-works.liquid, page.faqs.liquid, etc.).
  This used to unconditionally render {% section 'memobrick-site' %} —
  meaning About Us, Contact Us, Collabs, Track Your Order, Return Policy,
  and any other page still on the default template all showed the entire
  homepage SPA instead of their own actual content. Now shows the page's
  real title and body content instead, with the standard site header and
  footer, which is what a generic content-page template should do by
  default. Pages that need the specific richer layouts already have their
  own templates and are unaffected by this change.
{%- endcomment -%}
{%- liquid
  assign is_free_proof = false
  if page.handle == 'free-preview' or page.handle == 'free-proof' or page.handle == 'free-preview-1' or page.handle == 'free-proof-1'
    assign is_free_proof = true
  elsif page.content == blank and page.title contains 'Free Proof'
    assign is_free_proof = true
  endif
-%}
{%- render 'site-header' -%}
{%- if is_free_proof -%}
{%- comment -%}
  The Free Proof page is often left on the default template, which showed
  only its (empty) title. Render the real Free Proof design instead.
{%- endcomment -%}
{%- render 'free-proof-page' -%}
{%- else -%}
<div class="wrap" style="padding:48px 20px 90px;max-width:820px">
  <p style="font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3)">
    <a href="/" style="color:inherit;text-decoration:none">MemoBrick</a> <span aria-hidden="true">›</span> {{ page.title | escape }}
  </p>
  <h1 style="font-family:var(--display);font-size:32px;letter-spacing:-.03em;margin:10px 0 24px">{{ page.title | escape }}</h1>
  <div class="page-prose" style="color:var(--ink-2);font-size:16px;line-height:1.7">
    {{ page.content }}
  </div>
</div>
{%- endif -%}
{%- render 'site-footer' -%}
<style>
  .page-prose h2{font-family:var(--display);font-weight:600;font-size:24px;color:var(--ink);margin:32px 0 12px;letter-spacing:-.01em}
  .page-prose h3{font-family:var(--display);font-weight:600;font-size:19px;color:var(--ink);margin:26px 0 10px}
  .page-prose p{margin:0 0 16px}
  .page-prose ul,.page-prose ol{margin:0 0 16px;padding-left:22px}
  .page-prose li{margin-bottom:6px}
  .page-prose a{color:var(--b-red);text-decoration:underline}
  .page-prose img{max-width:100%;height:auto;border-radius:12px;margin:16px 0}
  .page-prose strong{color:var(--ink);font-weight:600}
</style>

