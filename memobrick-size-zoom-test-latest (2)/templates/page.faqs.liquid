{%- comment -%}
  Standalone, crawlable FAQ page — see page.how-it-works.liquid for why this
  exists as its own template instead of showing the full homepage SPA.
  Content kept in sync by hand with the homepage's #faq section.
  FAQPage structured data is added here (and only here, once) since this is
  the canonical FAQ URL — duplicating it on the homepage as well would be
  the same content claiming to be canonical in two places.
{%- endcomment -%}
{%- assign faqs = "Which photos work best?|One clear subject filling most of the frame, lit from the front or the side. Busy backgrounds turn to noise at this resolution — crop in close with the slider in the Creator, and check the result at arm's length rather than nose-to-screen.//Will it look like the preview?|Yes, allowing for the fact that screens vary in brightness and color. The proof we email is generated from the same color matching used in the Creator.//What happens to my photo?|The mosaic preview is built in your browser. We keep a copy of your photo and design so we can help you finish it and produce your order. We never share or sell it.//Are the bricks compatible with the ones I own?|MemoBrick uses standard 1×1 plates and compatible baseplates. Our 40+ color palette helps preserve skin tones, shadows and small details from your photo.//How long does shipping take?|Kits are made to order and normally dispatch in 2–4 business days, then travel by tracked post.//What if a brick is missing?|Send us the color name and count from your parts list and replacements go out free, for as long as you own the kit." | split: "//" -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for pair in faqs -%}
      {%- assign parts = pair | split: "|" -%}
      {%- unless forloop.first %},{% endunless -%}
      {
        "@type": "Question",
        "name": {{ parts[0] | strip | json }},
        "acceptedAnswer": { "@type": "Answer", "text": {{ parts[1] | strip | json }} }
      }
    {%- endfor -%}
  ]
}
</script>

{%- render 'site-header' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "MemoBrick", "item": {{ request.origin | append: '/' | json }} },
    { "@type": "ListItem", "position": 2, "name": "FAQs", "item": {{ canonical_url | json }} }
  ]
}
</script>
<div class="wrap" style="padding:48px 20px 90px;max-width:820px">
  <p style="font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3)">
    <a href="/" style="color:inherit;text-decoration:none">MemoBrick</a> <span aria-hidden="true">›</span> FAQs
  </p>
  <h1 style="font-family:var(--display);font-size:34px;letter-spacing:-.03em;margin:10px 0 34px">Before you order.</h1>

  <div class="faq">
    {%- for pair in faqs -%}
      {%- assign parts = pair | split: "|" -%}
      <details{% if forloop.first %} open{% endif %}>
        <summary>{{ parts[0] | strip }}</summary>
        <p>{{ parts[1] | strip }}</p>
      </details>
    {%- endfor -%}
  </div>

  <p style="margin-top:40px">
    <a class="btn btn-ghost" href="/pages/how-it-works">See how it works</a>
    <a class="btn btn-red" href="/pages/editor">Start designing</a>
  </p>
</div>

{%- render 'site-footer' -%}
