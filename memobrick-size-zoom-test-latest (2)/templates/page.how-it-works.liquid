<script>
(function(){
  var ON='min-height: 44px; padding: 0 18px; border-radius: 999px; border: 2px solid #0E142C; background: #0E142C; color: #FFFFFF; font-family: inherit; font-size: 15px; font-weight: 800; cursor: pointer', OFF='min-height: 44px; padding: 0 18px; border-radius: 999px; border: 2px solid #0E142C; background: #FFFFFF; color: #0E142C; font-family: inherit; font-size: 15px; font-weight: 600; cursor: pointer';
  var btns=document.querySelectorAll('.hiw-size-btn'), pics=document.querySelectorAll('.hiw-size-pic');
  btns.forEach(function(b){ b.addEventListener('click', function(){
    var i=b.getAttribute('data-i');
    btns.forEach(function(x){ var on=x===b; x.setAttribute('aria-pressed', on?'true':'false'); x.setAttribute('style', on?ON:OFF); });
    pics.forEach(function(p){ p.hidden = p.getAttribute('data-i')!==i; });
  }); });
})();
</script>
