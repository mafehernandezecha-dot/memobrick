{%- comment -%}
  "How it works" page, from the store owner's design (Plus Jakarta Sans,
  six steps, promises, reviews, gift block, FAQ, closing CTA). The design
  tool's runtime is not used: the markup is static, and the only
  interactive part, the size comparison in step 2, is the small script at
  the end. Styles are inline and scoped to .hiw, so the site header and
  footer keep their own look. Assigned to the page with the template
  "how-it-works" (Online Store > Pages > How it works > Theme template).
{%- endcomment -%}
{%- render 'site-header' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "MemoBrick", "item": {{ request.origin | append: '/' | json }} },
    { "@type": "ListItem", "position": 2, "name": "How it works", "item": {{ canonical_url | json }} }
  ]
}
</script>
