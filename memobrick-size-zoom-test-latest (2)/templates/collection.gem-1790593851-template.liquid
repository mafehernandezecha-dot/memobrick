{%- render 'site-header' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": {{ collection.title | json }},
  "url": {{ canonical_url | json }},
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": [
      {%- for product in collection.products limit: 24 -%}
        {
          "@type": "ListItem",
          "position": {{ forloop.index }},
          "url": {{ product.url | prepend: request.origin | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
}
</script>
<div class="wrap" style="padding:40px 20px 80px;max-width:1200px">
  <p style="font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3)">MemoBrick</p>
  <h1 style="font-family:var(--display);font-size:30px;margin:6px 0 10px">{{ collection.title | escape }}</h1>
  {%- comment -%}
    A collection-page trust line. Per-product star ratings would need a live
    Loox pull per product, which this template doesn't have; the aggregate
    store rating is real and already shown on the homepage and PDP, so it's
    surfaced here too rather than leaving collection pages with no trust
    signal at all.
  {%- endcomment -%}
  <p style="font-size:13.5px;color:var(--ink-2);margin:0 0 18px">
    <span style="color:var(--b-yellow,#F5C518)">★★★★★</span> <b>4.8</b> · 747 MemoBrick reviews
  </p>
  {%- comment -%} every collection shares this one template, so the column count is
  chosen per-collection here rather than hardcoded — the Artist Collection asked for
  3 across specifically; everything else keeps the original 4. {%- endcomment -%}
  {% assign base_cols = 4 %}
  {% assign is_artist_collection = false %}
  {% if collection.handle == "catalogue-picture" %}
    {% assign base_cols = 3 %}
    {% assign is_artist_collection = true %}
  {% endif %}
  <div class="collection-grid{% if is_artist_collection %} collection-grid-3{% endif %}" style="display:grid;grid-template-columns:repeat({{ base_cols }},1fr);gap:18px">
  {% for product in collection.products %}
    {% if product.title contains "Custom Bricked Mosaic" or product.title contains "Custom Brick Portrait" %}
      {%- comment -%} route straight into the editor with this exact size pre-selected,
      bypassing the product page entirely (some of these are connected to GemPages,
      which would otherwise hijack the page) — 20x20 is only a fallback when the
      specific size can't be determined from the handle {%- endcomment -%}
      {% assign size_id = "20x20" %}
      {% case product.handle %}
        {% when "custom-bricked-mosaic-10x10" %} {% assign size_id = "10x10" %}
        {% when "1-big-board" %} {% assign size_id = "16x16" %}
        {% when "2-2-boards" %} {% assign size_id = "20x20" %}
        {% when "2-3-boards" %} {% assign size_id = "20x30" %}
        {% when "3-2-boards" %} {% assign size_id = "30x20" %}
        {% when "20x40fits-1-3-individuals" %} {% assign size_id = "20x40" %}
        {% when "4-2-boards" %} {% assign size_id = "40x20" %}
        {% when "2-5-boards" %} {% assign size_id = "20x50" %}
        {% when "5-2-boards" %} {% assign size_id = "50x20" %}
        {% when "3-3-boards" %} {% assign size_id = "30x30" %}
        {% when "3-4-boards" %} {% assign size_id = "30x40" %}
        {% when "4-3-boards" %} {% assign size_id = "40x30" %}
        {% when "3-5-boards" %} {% assign size_id = "30x50" %}
        {% when "5-3-boards" %} {% assign size_id = "50x30" %}
        {% when "4-4-boards" %} {% assign size_id = "40x40" %}
        {% when "4-5-boards" %} {% assign size_id = "40x50" %}
        {% when "5-5-board" %} {% assign size_id = "50x50" %}
        {% when "custom-bricked-mosaic-portrait-60x30" %} {% assign size_id = "60x30" %}
        {% when "custom-bricked-mosaic-portrait-50x60" %} {% assign size_id = "50x60" %}
        {% when "60x60-fits-1-9-individuals" %} {% assign size_id = "60x60" %}
      {% endcase %}
      {%- comment -%} newer sizes: matched on title so a handle change can't send them to 20x20 {%- endcomment -%}
      {% if product.title contains "60x20" %}{% assign size_id = "60x20" %}{% elsif product.title contains "70x60" %}{% assign size_id = "70x60" %}{% endif %}
      {% assign product_href = "/pages/editor?size=" | append: size_id | append: "#editor" %}
    {% else %}
      {% assign product_href = product.url %}
    {% endif %}
    <a href="{{ product_href }}" style="text-decoration:none;min-width:0">
      {% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" style="display:block;width:100%;height:auto;aspect-ratio:1/1;object-fit:cover;border-radius:12px">{% endif %}
      <b style="display:block;margin-top:8px">{{ product.title | escape }}</b>
      <span style="color:var(--ink-2)">{{ product.price | money }}</span>
    </a>
  {% endfor %}
  </div>
  <p style="margin-top:32px"><a href="/" style="color:var(--b-blue);font-weight:600">&larr; Back to MemoBrick</a></p>
</div>
{%- render 'site-footer' -%}
<style>
  @media(max-width:900px){ .collection-grid{grid-template-columns:repeat(3,1fr) !important} }
  @media(max-width:640px){ .collection-grid{grid-template-columns:repeat(2,1fr) !important} }
  @media(max-width:420px){ .collection-grid{grid-template-columns:1fr !important} }
  /* Artist Collection asked to stay at 3 across even on phones, instead
     of stepping down to 2 then 1 like every other collection here does —
     higher specificity than the generic rules above so it wins at every
     width without changing those rules for anyone else. */
  @media(max-width:900px){ .collection-grid.collection-grid-3{grid-template-columns:repeat(3,1fr) !important} }
  @media(max-width:640px){ .collection-grid.collection-grid-3{grid-template-columns:repeat(3,1fr) !important} }
  @media(max-width:420px){ .collection-grid.collection-grid-3{grid-template-columns:repeat(3,1fr) !important;gap:8px} }
</style>
