<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{{ page_title }}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}</title>
  {%- comment -%}
    Shopify only populates page_description when the merchant has set an
    explicit "Search engine listing" description in admin (or, for
    products/collections, derives one from the description field). Pages
    without either — most notably these custom-built standalone pages —
    previously rendered with no meta description tag at all, leaving
    Google to auto-generate a snippet from whatever text it finds. These
    fallbacks only apply when page_description is genuinely blank; a
    real admin-set description always wins.
  {%- endcomment -%}
  {%- assign meta_description = page_description -%}
  {%- if meta_description == blank and template.name == 'index' -%}
    {%- assign meta_description = "Turn your favourite photo into a custom brick mosaic. Upload a photo, preview it live, and we'll ship everything you need to build it — free design proof before production, 747 reviews averaging 4.8 stars." -%}
  {%- endif -%}
  {%- if meta_description == blank and template.name == 'article' -%}
    {%- if article.excerpt != blank -%}
      {%- assign meta_description = article.excerpt | strip_html | truncate: 160 -%}
    {%- else -%}
      {%- assign meta_description = article.content | strip_html | truncate: 160 -%}
    {%- endif -%}
  {%- endif -%}
  {%- if meta_description == blank and template.name == 'blog' -%}
    {%- assign meta_description = blog.title | append: " — brick mosaic tips, size guides and stories from MemoBrick customers." -%}
  {%- endif -%}
  {%- if meta_description == blank -%}
    {%- case template.suffix -%}
      {%- when 'how-it-works' -%}
        {%- assign meta_description = "Upload a photo, preview it live in the free Creator, and get a personalised brick mosaic kit shipped to your door. See exactly how MemoBrick works, step by step." -%}
      {%- when 'faqs' -%}
        {%- assign meta_description = "Answers to the questions people ask before ordering a MemoBrick — photo requirements, accuracy, privacy, brick compatibility, shipping and missing pieces." -%}
      {%- when 'happy-customers' -%}
        {%- assign meta_description = "747 MemoBrick reviews averaging 4.8 stars, with real customer photos of finished brick mosaics — gifts, portraits and memorials." -%}
      {%- when 'custom-brick-mosaic-vs-alternatives' -%}
        {%- assign meta_description = "How MemoBrick's proof-before-production process, face-aware sizing and real reviews compare to other ways to turn a photo into brick art." -%}
      {%- when 'free-preview', 'freepreview' -%}
        {%- assign meta_description = "Upload your photo and get a free MemoBrick design proof from a real designer before you order. No payment, no obligation." -%}
      {%- when 'editor' -%}
        {%- assign meta_description = "Design your own custom brick photo mosaic in the free online Creator — upload a photo, preview it instantly, and choose your size." -%}
    {%- endcase -%}
  {%- endif -%}
  {%- if meta_description != blank %}<meta name="description" content="{{ meta_description | escape }}">{% endif -%}
  <link rel="canonical" href="{{ canonical_url }}">

  {%- comment -%}
    Social sharing (Open Graph + Twitter Card). Falls back through: this
    page's own image (product/collection/article) -> the theme's configured
    default social image -> the logo, so a preview card always has an
    image even before the merchant sets anything explicitly.
  {%- endcomment -%}
  {%- assign og_image = page_image | default: settings.social_share_image -%}
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:type" content="{% if template contains 'product' %}product{% elsif template.name == 'article' %}article{% else %}website{% endif %}">
  {%- if template.name == 'article' %}<meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">{% endif -%}
  <meta property="og:title" content="{{ page_title }}">
  {%- if meta_description != blank %}<meta property="og:description" content="{{ meta_description | escape }}">{% endif -%}
  <meta property="og:url" content="{{ canonical_url }}">
  {%- if og_image %}<meta property="og:image" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">{% endif -%}
  {%- if request.locale.iso_code %}<meta property="og:locale" content="{{ request.locale.iso_code | replace: '-', '_' }}">{% endif -%}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page_title }}">
  {%- if meta_description != blank %}<meta name="twitter:description" content="{{ meta_description | escape }}">{% endif -%}
  {%- if og_image %}<meta name="twitter:image" content="https:{{ og_image | image_url: width: 1200 }}">{% endif -%}

  {%- if settings.favicon %}
  <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  {%- comment -%}
    Organization/WebSite structured data — helps search engines associate
    the brand's name, logo and social profiles with this site, and is a
    prerequisite for a Google sitelinks searchbox. Kept to fields that are
    genuinely true site-wide; nothing product-specific belongs here.
  {%- endcomment -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ request.origin | append: '/' | json }}
    {%- if settings.favicon %},
    "logo": {{ settings.favicon | image_url: width: 512 | prepend: 'https:' | json }}
    {%- endif -%}
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ shop.name | json }},
    "url": {{ request.origin | append: '/' | json }}
  }
  </script>

  {%- comment -%}
    Shopify requires content_for_header for analytics, apps and checkout.
    It carries no design. No other theme's header, footer or CSS is loaded.
  {%- endcomment -%}
  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  {{ 'memobrick.css' | asset_url | stylesheet_tag }}
</head>
<body class="memobrick-site template-{{ template.name }}">
  <script>window.MB_FREE_SHIPPING_THRESHOLD = {{ settings.free_shipping_threshold | default: 125 }};</script>
  {{ content_for_layout }}
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/4.2.1/jspdf.umd.min.js" defer></script>
  <script src="{{ 'memobrick.js' | asset_url }}" defer></script>
  {%- if settings.email_gate_enabled -%}
    <script>
      window.MB_EMAIL_GATE = {
        enabled: true,
        root: {{ routes.root_url | append: '/' | replace: '//', '/' | json }},
        customerEmail: {{ customer.email | default: '' | json }},
        delay: {{ settings.email_gate_delay | default: 0 }},
        skipDays: {{ settings.email_gate_skip_days | default: 3 }},
        heading: {{ settings.email_gate_heading | json }},
        text: {{ settings.email_gate_text | json }},
        button: {{ settings.email_gate_button | json }},
        skip: {{ settings.email_gate_skip | json }},
        fine: {{ settings.email_gate_fine | json }},
        tags: {{ settings.email_gate_tags | json }},
        secondAfter: {{ settings.email_gate_second_after | default: 75 }},
        secondHeading: {{ settings.email_gate_second_heading | json }},
        secondText: {{ settings.email_gate_second_text | json }},
        secondButton: {{ settings.email_gate_second_button | json }},
        exitHeading: {{ settings.email_gate_exit_heading | json }},
        exitText: {{ settings.email_gate_exit_text | json }}
      };
    </script>
    <script src="{{ 'memobrick-email-gate.js' | asset_url }}" defer></script>
  {%- endif -%}
  {%- if settings.omnisend_design_enabled -%}
    <script>
      window.MB_OMNISEND_DESIGN = {
        enabled: true,
        eventName: {{ settings.omnisend_design_event | default: 'added design to cart' | json }},
        origin: {{ request.origin | json }},
        root: {{ routes.root_url | append: '/' | replace: '//', '/' | json }},
        currency: {{ cart.currency.iso_code | default: shop.currency | json }},
        customerEmail: {{ customer.email | default: '' | json }}
      };
    </script>
    <script src="{{ 'memobrick-omnisend-design.js' | asset_url }}" defer></script>
  {%- endif -%}
  {%- if settings.design_capture_enabled and settings.design_capture_url != blank -%}
    <script>
      window.MB_CAPTURE = {
        url: {{ settings.design_capture_url | json }},
        key: {{ settings.design_capture_key | json }},
        photo: {{ settings.design_capture_photo | json }}
      };
    </script>
    <script src="{{ 'memobrick-design-capture.js' | asset_url }}" defer></script>
  {%- endif -%}
</body>
</html>
