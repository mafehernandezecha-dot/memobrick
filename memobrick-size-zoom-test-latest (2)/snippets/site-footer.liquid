{%- comment -%}
  Site footer for standalone pages — see snippets/site-header.liquid for
  why this exists separately from the homepage's own footer markup.
{%- endcomment -%}
<footer>
  <div class="rainbow foot-rainbow" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
  <div class="wrap">
    <div class="foot">
      <a class="logo" href="/"><img referrerpolicy="no-referrer" class="logo-img" src="https://cdn.shopify.com/s/files/1/0375/0107/5595/files/Camara_Memobrick_1_copy_4_1c73c4e8-ec38-42a5-9d06-8513ecc122fb.png" alt="MemoBrick" onerror="this.style.display='none'"></a>
      <nav class="foot-links">
        <a href="/pages/how-it-works">How it works</a>
        <a href="/#freeproof">Get My Free Proof</a>
        <a href="/pages/happy-customers">Reviews</a>
        {%- assign blog_link = blank -%}
        {%- assign blog_menu = linklists['our-blog'] -%}
        {%- if blog_menu != blank and blog_menu.links.size > 0 -%}
          {%- assign blog_link = blog_menu.links.first -%}
        {%- endif -%}
        {%- if blog_link == blank -%}
          {%- for link in linklists['main-menu'].links -%}
            {%- if link.title contains 'Blog' and blog_link == blank -%}{%- assign blog_link = link -%}{%- endif -%}
          {%- endfor -%}
          {%- for link in linklists['footer'].links -%}
            {%- if link.title contains 'Blog' and blog_link == blank -%}{%- assign blog_link = link -%}{%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if blog_link != blank -%}<a href="{{ blog_link.url }}">Blog</a>{%- endif -%}
        <a href="/pages/custom-brick-mosaics-for-brands">Business services</a>
        <a href="/collections/catalogue-picture">Ready-made designs</a>
        <a href="/collections/photo-frames">Frames</a>
        <a href="{{ routes.account_url }}">Track your order</a>
        <a href="/#sizes">Sizes</a>
        <a href="/#giftinspo">Gift kit</a>
        <a href="/#faq">FAQs</a>
        <a href="/#view-corporate">Corporate &amp; bulk</a>
        <a href="/pages/contact-us">Contact</a>
      </nav>
    </div>
  </div>
</footer>
