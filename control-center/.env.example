# PostgreSQL connection string (Render, Neon, Supabase, Railway… all provide one)
DATABASE_URL=postgres://user:password@host:5432/memobrick

# First admin account, created automatically on the first start if no users exist
ADMIN_EMAIL=you@mymemobrick.com
ADMIN_NAME=Your Name
ADMIN_PASSWORD=change-me-to-something-long

# Shopify → Settings → Notifications → Webhooks: the signing key shown under the list
SHOPIFY_WEBHOOK_SECRET=
# optional: only accept webhooks from this shop
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com

# Sites allowed to send designs: the website and the Studio (comma separated, no trailing slash)
CORS_ORIGINS=https://mymemobrick.com,https://your-store.myshopify.com,https://memobrickdstudio.netlify.app

# optional: Slack / Zapier / Make incoming-webhook URL for low-stock alerts
ALERT_WEBHOOK_URL=

PORT=8080
