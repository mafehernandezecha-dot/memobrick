{%- comment -%}
  "Make yours" product card for blog articles (templates/article.liquid).
  series: 'calm' | 'christmas' | 'default'   place: 'intro' | 'end'   hero: (optional) hero asset name to avoid
  Self-contained (own CSS), so it can also be rendered from a GemPages Liquid element.
  Price and Loox rating from Shopify; picture is a real photo of a finished mosaic. Calm series points to the 16×16 kit
  (and to the Calm Build Gift page once a published page with handle
  calm-build-gift exists). No health claims.
{%- endcomment -%}
{%- liquid
  assign p10 = all_products['custom-bricked-mosaic-10x10']
  if series == 'calm'
    assign p = all_products['1-big-board']
    assign size = '16x16'
    assign size_label = '16×16 in kit'
  else
    assign p = all_products['2-2-boards']
    assign size = '20x20'
    assign size_label = '20×20 in kit'
  endif
  comment
    Card picture: a real product photo of a finished mosaic (theme asset),
    never a raw Studio export. Avoids repeating the hero picture (hero is the
    hero image file name).
  endcomment
  if series == 'calm'
    assign card_img = 'mb-real-color-bags.jpg'
    assign card_alt = 'Memobrick bags of 1×1 bricks, each labeled with its color name and number'
    assign card_cap = 'Bricks sorted by color in labeled bags'
    if hero contains 'color-bags-bright' or hero == 'mb-real-color-bags.jpg'
      assign card_img = 'mb-real-color-bags-soft.jpg'
    endif
  elsif hero contains 'framed-couple-wall' or hero == 'mb-real-couple-wall.jpg'
    assign card_img = 'mb-real-woman-portrait.jpg'
    assign card_alt = 'A woman at home with a finished, framed brick mosaic of her own portrait'
    assign card_cap = 'A finished mosaic. Frame sold separately'
  else
    assign card_img = 'mb-real-couple-wall.jpg'
    assign card_alt = 'A finished brick mosaic of a smiling couple, framed and hanging on a wall'
    assign card_cap = 'A finished mosaic. Frame sold separately'
  endif
  assign rating = p.metafields.loox.avg_rating.value | default: p.metafields.loox.avg_rating
  assign raters = p.metafields.loox.num_reviews.value | default: p.metafields.loox.num_reviews
  assign calm_page = pages['calm-build-gift']
-%}
<aside class="mba-card mba-card--{{ place }}" aria-label="Make your own brick mosaic">
  <a class="mba-card-img" href="/pages/editor?size={{ size }}#editor" tabindex="-1" aria-hidden="true">
    <img src="{{ card_img | asset_url }}" alt="{{ card_alt | escape }}" loading="lazy" width="1200" height="800">
    <span>{{ card_cap }}</span>
  </a>
  <div class="mba-card-txt">
    {%- if series == 'calm' -%}
      <p class="mba-card-eyebrow">A calm build, one row at a time</p>
      <p class="mba-card-h">{% if place == 'end' %}Ready when you are: start with the 16×16{% else %}Make yours with the 16×16 kit{% endif %}</p>
      <p class="mba-card-p">The smallest size: one baseplate and 2,500 bricks, sorted by color in labeled bags, with a printed color map. About 2.5 hours in total, easy to split into short sessions. Use a photo that matters to the builder.</p>
    {%- else -%}
      <p class="mba-card-eyebrow">{% if series == 'christmas' %}A gift they build, then hang on the wall{% else %}Your photo, built in bricks{% endif %}</p>
      <p class="mba-card-h">{% if place == 'end' %}Ready to make yours?{% else %}Make yours from a photo you love{% endif %}</p>
      <p class="mba-card-p">Upload a photo and see it as a custom brick mosaic before you order. Every kit comes with the 1×1 bricks, baseplates, your building map and the tool.</p>
    {%- endif -%}
    <p class="mba-card-price">
      <b>{{ size_label }} {{ p.price_min | money }}</b>
      {%- if series != 'calm' and p10.price_min > 0 %}<span> · sizes from {{ p10.price_min | money }}</span>{% endif -%}
      {%- if rating != blank %}<span class="mba-card-stars"><span aria-hidden="true">★</span> {{ rating }} ({{ raters }} reviews)</span>{% endif -%}
    </p>
    <div class="mba-card-btns">
      <a class="btn btn-red" href="/pages/editor?size={{ size }}#editor" data-mba-cta="card-{{ place }}">{% if series == 'calm' %}Start a 16×16 design{% else %}Upload my photo{% endif %}</a>
      <a class="btn mba-btn-ghost" href="/pages/free-preview" data-mba-cta="proof-{{ place }}">Get a free design proof</a>
    </div>
    {%- if series == 'calm' -%}
      {%- if calm_page != blank and calm_page.handle == 'calm-build-gift' -%}
        <p class="mba-card-note"><a href="{{ calm_page.url }}">See the Calm Build Gift, with a free printable build plan</a></p>
      {%- endif -%}
      <p class="mba-card-note">Small bricks: not for young children who put things in their mouths.</p>
    {%- else -%}
      <p class="mba-card-note">The free proof is optional: our designers make the design for you and send it before anything is made.</p>
    {%- endif -%}
  </div>
</aside>
<style>
  .mba-card{display:grid;grid-template-columns:260px 1fr;gap:22px;align-items:center;max-width:var(--mba-col,700px);margin:30px auto 34px;padding:16px;background:var(--card,#fff);border:1px solid var(--line);border-radius:20px;box-shadow:0 16px 36px -28px rgba(21,23,27,.4);font-size:15px;line-height:1.5;color:var(--ink-2)}
  .mba-card--end{max-width:var(--mba-wide,1040px);grid-template-columns:380px 1fr;margin-top:10px;margin-bottom:46px;padding:20px}
  .mba-card-img{display:block;border-radius:14px;overflow:hidden;background:var(--paper,#f3f1ec)}
  .mba-card-img{position:relative}
  .mba-card-img span{position:absolute;left:8px;bottom:8px;background:rgba(255,255,255,.92);color:var(--ink-2);font-size:11px;line-height:1.2;padding:4px 8px;border-radius:999px}
  .mba-card-img img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;object-position:50% 40%;margin:0;border-radius:0}
  .page-prose .mba-card a.btn{text-decoration:none}
  .mba-card p{margin:0}
  .mba-card-eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--b-red)}
  .mba-card-h{font-family:var(--display);font-weight:600;font-size:22px;line-height:1.2;color:var(--ink);margin:6px 0 8px !important}
  .mba-card--end .mba-card-h{font-size:28px}
  .mba-card-price{margin:12px 0 14px !important;display:flex;flex-wrap:wrap;gap:4px 10px;align-items:baseline;color:var(--ink-3);font-size:14px}
  .mba-card-price b{font-family:var(--display);font-weight:600;font-size:18px;color:var(--ink)}
  .mba-card-stars{color:var(--ink-2)}
  .mba-card-stars span{color:#f7c90f}
  .mba-card-btns{display:flex;flex-wrap:wrap;gap:10px}
  .mba-card-btns .btn{flex:1 1 180px;text-decoration:none}
  .mba-btn-ghost{background:transparent !important;color:var(--ink) !important;border:1.5px solid var(--ink) !important}
  .mba-card-note{font-size:12.5px;color:var(--ink-3);margin-top:10px !important}
  .page-prose .mba-card-note a{color:var(--ink-2)}
  @media (max-width:760px){
    .mba-card,.mba-card--end{grid-template-columns:1fr;gap:14px;padding:14px}
    .mba-card--end .mba-card-h{font-size:24px}
  }
</style>
