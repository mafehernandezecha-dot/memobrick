{%- render 'site-header' -%}
{%- assign mb_free_at = 12500 -%}
{%- assign mb_is_us = false -%}
{%- if localization.country.iso_code == 'US' or localization.country.iso_code == blank -%}{%- assign mb_is_us = true -%}{%- endif -%}
<div class="wrap" style="padding:40px 20px 80px;max-width:900px">
  <p style="font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3)">MemoBrick</p>
  <h1 style="font-family:var(--display);font-size:34px;letter-spacing:-.03em;margin:6px 0 18px">Your cart</h1>
  {% if cart.item_count == 0 %}
    <p style="color:var(--ink-2)">Your cart is empty.</p>
    <p style="margin-top:18px"><a class="btn btn-red" href="/">Create your MemoBrick</a></p>
  {% else %}
  <form action="/cart" method="post" novalidate>
    {% for item in cart.items %}
      <div style="display:flex;gap:16px;padding:16px 0;border-bottom:1px solid var(--line)">
        {%- assign design_img = item.properties['Final Design'] -%}
        {% if design_img != blank and design_img contains 'https://' %}
          <img src="{{ design_img }}" alt="Your mosaic design" width="80" height="80" loading="lazy" style="width:80px;height:80px;object-fit:contain;background:#f3f1ec;border-radius:8px;flex:0 0 auto">
        {% elsif item.image %}<img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" width="80" height="80" style="width:80px;height:80px;object-fit:cover;border-radius:8px;flex:0 0 auto">{% endif %}
        <div style="flex:1;min-width:0">
          <b>{{ item.product.title }}</b>
          {% if item.variant.title contains 'Build at home' %}
            <div style="font-family:var(--mono);font-size:12px;color:var(--ink-3)">Build-at-home kit</div>
          {% else %}
            <div style="font-family:var(--mono);font-size:12px;color:var(--ink-3)">{{ item.variant.title }}</div>
          {% endif %}
          {% for p in item.properties %}
            {% unless p.last == blank or p.first == '_design' or p.first contains '_' or p.first == 'Final Design' or p.first == 'Design ID' or p.first == 'Brick grid' or p.first == 'Build service' or p.first == 'Orientation' %}
              <div style="font-size:12.5px;color:var(--ink-2);overflow-wrap:anywhere">{{ p.first }}: {{ p.last }}</div>
            {% endunless %}
          {% endfor %}
          {% if forloop.last %}
            <a href="/pages/editor#editor" style="display:inline-block;margin-top:8px;font-size:12.5px;color:var(--b-blue);font-weight:600;text-decoration:underline">Edit this design again</a>
          {% endif %}
        </div>
        <div style="text-align:right">
          <div><b>{{ item.final_line_price | money }}</b></div>
          <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width:64px;margin-top:8px;padding:8px;border:1px solid var(--line);border-radius:8px">
          <div style="margin-top:8px">
            <a href="{{ item.url_to_remove }}" style="font-size:12.5px;color:var(--ink-3);text-decoration:underline">Remove</a>
          </div>
        </div>
      </div>
    {% endfor %}
    <div style="display:flex;justify-content:space-between;align-items:center;margin-top:20px">
      <b style="font-size:20px">Total {{ cart.total_price | money }}</b>
      <span>
        <button type="submit" name="update" class="mini" style="min-height:44px">Update</button>
        <button type="submit" name="checkout" class="btn btn-red" style="min-height:44px">Checkout</button>
      </span>
    </div>

    <div id="mbShip" data-free-at="{{ mb_free_at }}" data-total="{{ cart.total_price }}" style="margin-top:18px;padding:14px 16px;border:1px solid var(--line);border-radius:10px;font-size:13.5px;color:var(--ink-2)">
      {%- if mb_is_us -%}
        {%- if cart.total_price >= mb_free_at -%}
          <p style="margin:0;color:var(--ink);font-weight:600">Your order qualifies for free US shipping.</p>
        {%- else -%}
          {%- assign mb_need = mb_free_at | minus: cart.total_price -%}
          <p style="margin:0;color:var(--ink);font-weight:600">Free US shipping on orders $125 and up.</p>
          <p style="margin:2px 0 0">Add {{ mb_need | money }} more to get free shipping.</p>
          <div style="margin-top:12px">
            <label for="mbShipZip" style="display:block;font-size:12.5px;color:var(--ink-3);margin-bottom:6px">Estimate shipping: choose your state and enter your ZIP code</label>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
              <select id="mbShipState" autocomplete="address-level1" aria-label="State" style="min-height:44px;padding:8px 10px;border:1px solid var(--line);border-radius:8px;font-size:16px;max-width:170px"><option value="">State</option><option value="AL">Alabama</option><option value="AK">Alaska</option><option value="AZ">Arizona</option><option value="AR">Arkansas</option><option value="CA">California</option><option value="CO">Colorado</option><option value="CT">Connecticut</option><option value="DE">Delaware</option><option value="DC">District of Columbia</option><option value="FL">Florida</option><option value="GA">Georgia</option><option value="HI">Hawaii</option><option value="ID">Idaho</option><option value="IL">Illinois</option><option value="IN">Indiana</option><option value="IA">Iowa</option><option value="KS">Kansas</option><option value="KY">Kentucky</option><option value="LA">Louisiana</option><option value="ME">Maine</option><option value="MD">Maryland</option><option value="MA">Massachusetts</option><option value="MI">Michigan</option><option value="MN">Minnesota</option><option value="MS">Mississippi</option><option value="MO">Missouri</option><option value="MT">Montana</option><option value="NE">Nebraska</option><option value="NV">Nevada</option><option value="NH">New Hampshire</option><option value="NJ">New Jersey</option><option value="NM">New Mexico</option><option value="NY">New York</option><option value="NC">North Carolina</option><option value="ND">North Dakota</option><option value="OH">Ohio</option><option value="OK">Oklahoma</option><option value="OR">Oregon</option><option value="PA">Pennsylvania</option><option value="RI">Rhode Island</option><option value="SC">South Carolina</option><option value="SD">South Dakota</option><option value="TN">Tennessee</option><option value="TX">Texas</option><option value="UT">Utah</option><option value="VT">Vermont</option><option value="VA">Virginia</option><option value="WA">Washington</option><option value="WV">West Virginia</option><option value="WI">Wisconsin</option><option value="WY">Wyoming</option></select>
              <input id="mbShipZip" type="text" inputmode="numeric" autocomplete="postal-code" maxlength="10" placeholder="ZIP code" style="width:130px;min-height:44px;padding:8px 12px;border:1px solid var(--line);border-radius:8px;font-size:16px">
              <button type="button" id="mbShipGo" class="mini" style="min-height:44px">Get rates</button>
            </div>
            <div id="mbShipOut" role="status" aria-live="polite" style="margin-top:10px"></div>
          </div>
        {%- endif -%}
      {%- else -%}
        <p style="margin:0">Shipping is calculated at checkout.</p>
      {%- endif -%}
    </div>
    {%- assign mb_xmas_end = '2026-12-16' | date: '%s' -%}
    {%- assign mb_now = 'now' | date: '%s' -%}
    {%- if mb_now < mb_xmas_end -%}
      <p style="font-size:13px;color:var(--ink-2);margin-top:12px">Order by December 15 to receive it before Christmas.</p>
    {%- endif -%}
    <p style="font-size:12px;color:var(--ink-3);margin-top:6px">Taxes are calculated at checkout.</p>
  </form>
  {% endif %}
  <p style="margin-top:32px"><a href="/" style="color:var(--b-blue);font-weight:600">&larr; Back to MemoBrick</a></p>
</div>
<script>
(function(){
  var st=document.getElementById('mbShipState'),go=document.getElementById('mbShipGo'),zip=document.getElementById('mbShipZip'),out=document.getElementById('mbShipOut');
  if(!go||!zip||!out||!st)return;
  function money(c){return '$'+(Number(c)).toFixed(2);}
  function esc(s){return String(s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});}
  function say(h){out.innerHTML=h;}
  function fail(){say('<span style="color:var(--ink-2)">We could not get rates here. Your exact shipping cost shows at checkout, and orders of $125 and up ship free in the US.</span>');go.disabled=false;}
  var qs=function(z){return 'shipping_address[zip]='+encodeURIComponent(z)+'&shipping_address[country]=United%20States&shipping_address[province]='+encodeURIComponent(st.value);};
  function show(rates){
    if(!rates||!rates.length){say('<span style="color:var(--ink-2)">No rates found for that ZIP code. Check it, or see your options at checkout.</span>');go.disabled=false;return;}
    var h='<div style="font-size:12.5px;color:var(--ink-3);margin-bottom:6px">Estimated shipping for '+esc(st.value)+' '+esc(zip.value.trim())+':</div><ul style="list-style:none;margin:0;padding:0">';
    rates.forEach(function(r){h+='<li style="display:flex;justify-content:space-between;gap:12px;padding:6px 0;border-top:1px solid var(--line)"><span>'+esc(r.presentment_name||r.name)+'</span><b>'+money(r.price)+'</b></li>';});
    h+='</ul><div style="font-size:12px;color:var(--ink-3);margin-top:6px">Live carrier rates for your address. The final amount is confirmed at checkout.</div>';
    say(h);go.disabled=false;
  }
  function poll(z,n){
    fetch('/cart/async_shipping_rates.json?'+qs(z),{headers:{'Accept':'application/json'}}).then(function(r){
      if(r.status===202&&n<20){setTimeout(function(){poll(z,n+1);},700);return null;}
      if(!r.ok)throw 0;return r.json();
    }).then(function(d){if(d)show(d.shipping_rates);}).catch(fail);
  }
  function run(){
    var z=zip.value.trim();
    if(!st.value){say('<span style="color:#b3261e">Choose your state.</span>');st.focus();return;}
    if(!/^\d{5}(-\d{4})?$/.test(z)){say('<span style="color:#b3261e">Enter a 5-digit US ZIP code.</span>');zip.focus();return;}
    go.disabled=true;say('<span style="color:var(--ink-3)">Getting rates…</span>');
    fetch('/cart/prepare_shipping_rates.json?'+qs(z),{method:'POST',headers:{'Accept':'application/json'}}).then(function(r){if(!r.ok&&r.status!==202)throw 0;poll(z,0);}).catch(fail);
  }
  go.addEventListener('click',run);
  zip.addEventListener('keydown',function(e){if(e.key==='Enter'){e.preventDefault();run();}});
})();
</script>
{%- render 'site-footer' -%}
