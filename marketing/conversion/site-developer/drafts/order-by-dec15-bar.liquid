{%- comment -%}
  DRAFT, not tested, not in any theme. Order-by-Dec-15 bar (idea 2026-10-29).
  Render with {% render 'mb-dec15-bar' %} on home, dog page, ready-made product pages and cart.
  Wording uses only Facts-table claims: Dec 15 order-by date and Miami. No code, no timer.
  Hide after Dec 15 so it never makes a false claim.
{%- endcomment -%}
{%- assign mb_now = 'now' | date: '%s' | plus: 0 -%}
{%- assign mb_end = '2026-12-16 00:00:00 -0500' | date: '%s' | plus: 0 -%}
{%- if mb_now < mb_end -%}
<div class="mb-dec15-bar" role="note">Order by December 15 to get it before Christmas. Made and shipped from Miami.</div>
<style>
  .mb-dec15-bar{background:#f4efe6;color:#2b2b2b;text-align:center;font-size:14px;line-height:1.35;padding:8px 16px}
  @media (max-width:600px){.mb-dec15-bar{font-size:13px}}
</style>
{%- endif -%}
